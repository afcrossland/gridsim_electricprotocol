{
  "hosting": [
    {
      "target": "electricfutures-dev",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "/klute{,/**}", "run": { "serviceId": "klute-gate-dev", "region": "us-central1" } }]
    },
    {
      "target": "electricfutures-prod",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "/klute{,/**}", "run": { "serviceId": "klute-gate-prod", "region": "us-central1" } }]
    }
  ]
}
